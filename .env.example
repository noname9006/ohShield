# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Configuration
COMMAND_PREFIX=%
BOT_ID=your_bot_id_here

# Database
MONGODB_URI=mongodb://localhost:27017/ohshield
DATABASE_NAME=ohshield

# Web Server (for Game2048 verification mode)
WEB_PUBLIC_URL=http://localhost:3000
WEB_PORT=3000

# Feature Flags
TEST_MODE=false
ENABLE_VERIFICATION=true
ENABLE_GLOBAL_RULES=true

# Rate Limits (in seconds)
REPORT_GUILD_COOLDOWN=10
REPORT_USER_COOLDOWN=60
REPORT_HOURLY_LIMIT=5

# Check Command Cooldown (in days)
CHECK_GLOBAL_COOLDOWN=30

# Image Storage
IMAGE_STORAGE_RETENTION_HOURS=24
ENABLE_IMAGE_STORAGE=false

# Logging
LOG_LEVEL=info
